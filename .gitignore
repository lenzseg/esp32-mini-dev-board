# ==============================================================================
# KiCad Project - Git Ignore Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local & User-Specific Configuration Files
# ------------------------------------------------------------------------------
# User preference file (window layouts, zoom levels, grid settings, color schemes)
*.kicad_prl

# KiCad 9.0+ built-in local version history directory
.history/

# Lock files created during multi-instance editing
~*.lck

# Footprint cache generated by KiCad footprint selectors
fp-info-cache

# ------------------------------------------------------------------------------
# 2. Backups & Auto-Save Files
# ------------------------------------------------------------------------------
# Automatic backups directory (KiCad 6+)
*-backups/

# Autosave & lock files
_autosave-*
#auto_saved_files#
*.bak
*.000
*.bck

# Legacy & file recovery backups
*.kicad_pcb-bak
*.kicad_sch-bak
*-save.pro
*-save.kicad_pcb

# General temp files & compressed archives
*.tmp
*.~
~*
*.zip
*.7z
*.tar.gz

# ------------------------------------------------------------------------------
# 3. Intermediate & Simulation Files
# ------------------------------------------------------------------------------
# Netlists (usually regenerated dynamically by KiCad/SPICE)
*.net

# External autorouter interface files (Electra, Freerouting)
*.dsn
*.ses

# SPICE / Ngspice simulation output logs and raw data files
*.raw
*.log

# ------------------------------------------------------------------------------
# 4. Manufacturing & Build Outputs (Ignored for Clean Git Repos)
# ------------------------------------------------------------------------------
# If you generate Gerber files, BOMs, or PDFs via GitHub Actions CI/CD, 
# ignore local generated build directories here:
/build/
/fab/
/plots/
/gerbers/
/outputs/

# Native fabricator export extensions (if saved in project root)
*.gbr
*.drl
*.pos
*.rpt

# Exported documentation (if generated automatically)
*.csv
*.xml

# ------------------------------------------------------------------------------
# 5. System & OS Junk
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
